# Copy this file to `.env` in the same directory (backend/.env) and fill in real values.
# .env is gitignored - never commit real API keys.

# --- Google Generative AI ---
GOOGLE_API_KEY="AQ.Ab8RN6JZLuZDfAJm36seMSEYa8P5NNYmmG_cpTjmIowFC4QblQ"

# Placeholders - gemini-1.5-pro and text-embedding-004/embedding-001 are
# retired as of 2026 (404). Confirm current model availability at
# https://ai.google.dev/gemini-api/docs/models before deploying.
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# --- Paths ---
DATA_DIR=./Data
DATABASE_DIR=./Database

# --- Chunking (Phase 1) ---
CHUNK_BREAKPOINT_PERCENTILE=92.0
CHUNK_MIN_CHARS=250
CHUNK_MAX_CHARS=2200
EMBEDDING_BATCH_SIZE=50

# --- Retrieval (Phase 2) ---
RETRIEVAL_K_DENSE=20
RETRIEVAL_K_SPARSE=20
RETRIEVAL_RRF_K=60
RETRIEVAL_FUSED_TOP_N=20

# --- HyDE (Phase 2) ---
HYDE_ENABLED=true
HYDE_MAX_OUTPUT_TOKENS=256

# --- Reranking (Phase 2) ---
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_TOP_N=5

# --- Session memory (Phase 2) ---
SESSION_TTL_MINUTES=30

# --- API (Phase 2) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_SESSION=10/minute

# --- Misc ---
LOG_LEVEL=INFO
ENVIRONMENT=local
