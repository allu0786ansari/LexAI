# Compose settings for the laptop overlay (deploy\lexai.bat passes this with --env-file).
# The LexAI settings themselves come from laptop-8gb.env, as without Docker.
COMPOSE_PROFILES=
LEXAI_IMAGE_TAG=local
LEXAI_WEB_BIND=127.0.0.1
LEXAI_WEB_PORT=8080
LEXAI_API_REPLICAS=1
# Ollama on the Windows host, reached from the containers.
LEXAI_LLM_BASE_URL=http://host.docker.internal:11434/v1
LEXAI_EMBED_BASE_URL=http://host.docker.internal:11434/v1
LEXAI_LLM_MODEL=qwen2.5-7b-instruct
LEXAI_EMBED_MODEL=nomic-embed-text
# Grafana listens on 127.0.0.1 only.
GRAFANA_ADMIN_PASSWORD=lexai-laptop
