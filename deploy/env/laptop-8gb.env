# lexai-profile: laptop-8gb v2
# LexAI profile for an 8 GB RAM laptop with a small (<= 4 GB) or no GPU.
# The Windows setup scripts copy this to backend\.env. When backend\.env does not
# start with the line above (older profile or a v0.1 .env), it is saved as
# backend\.env.previous first and then replaced.
# v2 (Phase 2): Qdrant index, smaller chunks, context budget in characters.
#
# Memory budget (approx.): Qwen2.5-7B Q4 ~4.7 GB split across GPU and RAM,
# nomic-embed-text ~0.3 GB, API process ~0.4 GB. No reranker: torch + the
# reranker model would add ~2.5 GB and push the machine into swapping.

# --- Generator: Qwen2.5-7B-Instruct built from deploy/ollama/Modelfile.laptop (4K context) ---
LEXAI_LLM_BASE_URL=http://localhost:11434/v1
LEXAI_LLM_MODEL=qwen2.5-7b-instruct
LEXAI_LLM_MAX_TOKENS=512
# Part of the model runs on the CPU, so the first token can take a while.
LEXAI_LLM_READ_TIMEOUT_S=600

# --- Embeddings: nomic-embed-text (small, 768-dim) with its required prefixes ---
LEXAI_EMBED_BASE_URL=http://localhost:11434/v1
LEXAI_EMBED_MODEL=nomic-embed-text
LEXAI_EMBED_DIMENSION=768
LEXAI_EMBED_QUERY_PREFIX="search_query: "
LEXAI_EMBED_DOCUMENT_PREFIX="search_document: "
LEXAI_EMBED_BATCH_SIZE=16
LEXAI_EMBED_TIMEOUT_S=180

# --- No reranker on this machine; the top 5 fused passages go to the model ---
LEXAI_RERANK_ENABLED=false
LEXAI_RERANK_TOP_N=5

# --- Index: embedded Qdrant in backend\var\qdrant (one process at a time: stop the
#     API before running a build). Smaller chunks so several fit in the 4K context. ---
LEXAI_CORPUS_MAX_CHUNK_CHARS=1400
LEXAI_CORPUS_CHUNK_OVERLAP_CHARS=150
LEXAI_QDRANT_KEEP_PREVIOUS=1

# --- Prompt budget inside the 4K context (tokens are roughly chars / 4):
#     ~300 system + ~1,600 passages (6,000 chars) + ~600 history + 512 answer ---
LEXAI_RETRIEVAL_CONTEXT_CHAR_BUDGET=6000
LEXAI_API_HISTORY_MESSAGES_IN_PROMPT=2
