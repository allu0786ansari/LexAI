# LexAI with Docker Compose. Copy to deploy/.env, then `make up` (see docs/runbook.md).
# Compose reads this file for its own settings (images, ports) and passes the LEXAI_*
# lines to the API and ingest containers. Every LexAI setting: backend/.env.example.

# Start the Ollama container with the stack (empty: use a model server elsewhere).
COMPOSE_PROFILES=ollama

# --- Images -------------------------------------------------------------------
# Local builds by default; a release sets LEXAI_REGISTRY=ghcr.io/<owner>/ and a version tag.
LEXAI_REGISTRY=
LEXAI_IMAGE_TAG=local

# --- Ports on this machine ------------------------------------------------------
LEXAI_WEB_PORT=8080
# API replicas behind nginx (sessions and limits are shared through Redis).
LEXAI_API_REPLICAS=1

# --- Secrets (CHANGE for any machine reachable from a network) --------------------
# Admin API (reindex). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEXAI_API_ADMIN_API_KEY=change-me-to-a-long-random-value
GRAFANA_ADMIN_PASSWORD=change-me

# --- Models (Ollama container; pulled into a volume on first start) ----------------
# The generator is built from deploy/ollama/Modelfile (Qwen2.5-7B-Instruct, 8K context).
# For a quick try on a small CPU machine: OLLAMA_LLM_MODELFILE= and
# LEXAI_LLM_MODEL=qwen2.5:0.5b-instruct (fast, much weaker answers).
OLLAMA_LLM_MODELFILE=/modelfiles/Modelfile
LEXAI_LLM_MODEL=qwen2.5-7b-instruct
LEXAI_EMBED_MODEL=nomic-embed-text
LEXAI_EMBED_DIMENSION=768
LEXAI_EMBED_QUERY_PREFIX="search_query: "
LEXAI_EMBED_DOCUMENT_PREFIX="search_document: "
# CPU generation is slow: give long prompts time before the first token.
LEXAI_LLM_READ_TIMEOUT_S=600

# --- Retrieval (the configuration measured in Phase 4) ------------------------------
LEXAI_RERANK_ENABLED=false
LEXAI_RERANK_TOP_N=5
LEXAI_CORPUS_MAX_CHUNK_CHARS=1400
LEXAI_CORPUS_CHUNK_OVERLAP_CHARS=150
LEXAI_RETRIEVAL_CONTEXT_CHAR_BUDGET=6000
LEXAI_QUERY_ABSTAIN_MIN_DENSE=0.63
LEXAI_QDRANT_KEEP_PREVIOUS=1

# --- Ingest job: limit to some documents, e.g. "--only constitution" (empty = all) ---
LEXAI_INGEST_ARGS=

# --- Traces to Langfuse (optional; `make up-observability` starts one locally) -------
# The keys below match deploy/langfuse/.env.example; change both together.
# LEXAI_OBS_OTLP_ENDPOINT=http://host.docker.internal:3000/api/public/otel/v1/traces
# LEXAI_OBS_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>
LEXAI_OBS_CAPTURE_TEXT=false
