# Server/GPU defaults. Copy to backend/.env and adjust; every variable is optional.
# For an 8 GB laptop use deploy/env/laptop-8gb.env instead (the Windows setup script does this).

# --- Generator (OpenAI-compatible: Ollama in dev, vLLM in prod) ---
LEXAI_LLM_BASE_URL=http://localhost:11434/v1
LEXAI_LLM_API_KEY=ollama
LEXAI_LLM_MODEL=qwen2.5-7b-instruct
LEXAI_LLM_TEMPERATURE=0.2
LEXAI_LLM_TOP_P=0.8
LEXAI_LLM_MAX_TOKENS=1024
LEXAI_LLM_CONNECT_TIMEOUT_S=5
# Raise this on CPU-only machines: a long prompt can take minutes before the first token.
LEXAI_LLM_READ_TIMEOUT_S=120
LEXAI_LLM_MAX_RETRIES=2

# --- Embeddings (OpenAI-compatible /embeddings: Ollama or TEI) ---
LEXAI_EMBED_BASE_URL=http://localhost:11434/v1
LEXAI_EMBED_API_KEY=ollama
LEXAI_EMBED_MODEL=qwen3-embedding:0.6b
LEXAI_EMBED_DIMENSION=1024
LEXAI_EMBED_BATCH_SIZE=32
# Prefixes the embedding model expects (qwen3-embedding: instruction on queries only).
LEXAI_EMBED_QUERY_PREFIX="Instruct: Given a question about Indian law, retrieve statute sections and judgment passages that answer it\nQuery: "
LEXAI_EMBED_DOCUMENT_PREFIX=""

# --- Reranker (in-process; needs `pip install -r requirements-rerank.txt`) ---
LEXAI_RERANK_ENABLED=true
LEXAI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LEXAI_RERANK_TOP_N=8

# --- Corpus (paths relative to the repository root) ---
LEXAI_CORPUS_MANIFEST=data/manifest.yaml
LEXAI_CORPUS_BUNDLED_DIR=data/bundled
LEXAI_CORPUS_RAW_DIR=data/raw
LEXAI_CORPUS_LOCK_FILE=data/manifest.lock.json
# Sections longer than this are split; changing it re-chunks everything on the next build.
LEXAI_CORPUS_MAX_CHUNK_CHARS=2400
LEXAI_CORPUS_CHUNK_OVERLAP_CHARS=200
LEXAI_CORPUS_DOWNLOAD_TIMEOUT_S=120

# --- Vector index: Qdrant ---
# Unset URL = embedded Qdrant stored at PATH (relative to backend/; one process at a time).
# LEXAI_QDRANT_URL=http://localhost:6333
# LEXAI_QDRANT_API_KEY=
LEXAI_QDRANT_PATH=var/qdrant
LEXAI_QDRANT_COLLECTION_ALIAS=lexai_chunks
LEXAI_QDRANT_KEEP_PREVIOUS=1

# --- Retrieval ---
LEXAI_RETRIEVAL_K_DENSE=40
LEXAI_RETRIEVAL_K_SPARSE=40
LEXAI_RETRIEVAL_FUSED_TOP_N=30
# Characters of passages in the prompt; keep (budget / 4) well inside the model's context.
LEXAI_RETRIEVAL_CONTEXT_CHAR_BUDGET=12000
LEXAI_RETRIEVAL_HYDE_ENABLED=false

# --- Query understanding, abstention, verification (Phase 3) ---
# One short model call rewrites follow-ups ("and is it bailable?") before searching.
LEXAI_QUERY_CONDENSE_ENABLED=true
LEXAI_QUERY_CONDENSE_TURNS=3
LEXAI_QUERY_MAX_REFERENCES=4
# Answer "not found" without generating when the best passage scores below this.
# Rerank score with a reranker, dense cosine without; calibrate per model (see runlogs/phase3).
# LEXAI_QUERY_ABSTAIN_MIN_DENSE=
# LEXAI_QUERY_ABSTAIN_MIN_RERANK=
LEXAI_QUERY_ABSTAIN_SHOW_SOURCES=3

# --- Answer cache (verified answers only) ---
LEXAI_CACHE_ENABLED=true
LEXAI_CACHE_TTL_S=86400
LEXAI_CACHE_MAX_ENTRIES=512
# Shared cache for several API workers (Phase 6): LEXAI_CACHE_REDIS_URL=redis://localhost:6379/0

# --- API ---
LEXAI_API_ENVIRONMENT=local
LEXAI_API_LOG_LEVEL=INFO
LEXAI_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEXAI_API_RATE_LIMIT_QUERY=20/minute
