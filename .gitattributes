# Windows batch files must keep CRLF line endings or cmd.exe misreads labels.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf
# Files read inside Linux containers keep LF even on a Windows checkout with autocrlf.
*.env       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.template  text eol=lf
Dockerfile  text eol=lf
Modelfile*  text eol=lf
.env.example text eol=lf
